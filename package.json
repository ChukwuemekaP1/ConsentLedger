{
  "name": "consentledger",
  "version": "0.1.0",
  "private": true,
  "description": "Control plane for AI agents that spend money: agents propose, humans sign with passkeys, PayPal settles.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20.9.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && prettier --check \"src/**\" \"tests/**\" \"*.{ts,mjs,cjs,json,yml}\" \"scripts/**/*.{ts,mjs,js}\"",
    "arch": "pnpm exec depcruise src --config .dependency-cruiser.cjs",
    "test:unit": "vitest run --project unit",
    "test:ui": "vitest run --project ui",
    "test:int": "node -e \"if (!process.env.DATABASE_URL) { console.error('\\n  test:int requires DATABASE_URL. Run pnpm db:up first, then set DATABASE_URL.\\n  Skipping integration tests.'); process.exit(0); } require('child_process').execSync('vitest run --project integration --passWithNoTests', { stdio: 'inherit' });\"",
    "test:e2e": "playwright test",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "verify:bundle": "tsx scripts/verify-bundle.ts",
    "verify": "pnpm typecheck && pnpm lint && pnpm arch && pnpm test:unit && pnpm test:ui && node scripts/verify-int.mjs && pnpm build"
  },
  "dependencies": {
    "@simplewebauthn/browser": "^14.0.0",
    "@simplewebauthn/server": "^14.0.3",
    "drizzle-orm": "^0.45.4",
    "next": "16.4.0",
    "pino": "10.4.0",
    "postgres": "^3.4.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "26.6.5",
    "@types/react": "19.1.8",
    "@types/react-dom": "19.1.5",
    "@typescript-eslint/eslint-plugin": "8.71.1",
    "@typescript-eslint/parser": "8.71.1",
    "@vitest/coverage-v8": "5.0.3",
    "dependency-cruiser": "18.5.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "10.12.0",
    "eslint-config-next": "16.4.0",
    "fast-check": "4.10.2",
    "jsdom": "^30.1.3",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  }
}

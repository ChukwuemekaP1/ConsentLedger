# ConsentLedger environment variables
# Copy this file to .env.local and fill in real values.
# Never commit .env.local or any file with real secrets.
# All variables are validated by src/infrastructure/config/env.ts at boot.

# ─── Required now (issue #1) ──────────────────────────────────────────────────

# Runtime environment. Options: development | test | production
NODE_ENV=development

# Pino log level. Options: trace | debug | info | warn | error | fatal | silent
LOG_LEVEL=info

# Payment settlement adapter. Options: paypal | simulated
# Use "simulated" locally until PayPal credentials are configured (issue #6).
SETTLEMENT_MODE=simulated

# LLM adapter mode. Options: live | mock
# Use "mock" in CI and locally until Gemini credentials are configured (issue #5).
LLM_MODE=mock

# Whether to expose /lab/* attack routes. Never true in production.
LAB_ENABLED=false

# Git commit SHA injected at build time (e.g. by CI). Shown in /api/v1/health.
COMMIT=unknown

# ─── Issue #3: Postgres ───────────────────────────────────────────────────────

# Full Postgres connection string. Required for integration tests and production.
# Local: set after running `pnpm db:up`.
# DATABASE_URL=postgresql://consentledger:consentledger@localhost:5432/consentledger
# Privileged connection string for running migrations and immutability tests.
# DATABASE_ADMIN_URL=postgresql://consentledger:consentledger@localhost:5432/consentledger

# ─── Issue #4: WebAuthn / Passkeys ───────────────────────────────────────────

# Relying party ID — must match the domain the app is served from.
# WEBAUTHN_RP_ID=localhost

# Relying party origin — must match exactly (scheme + host + port).
# WEBAUTHN_ORIGIN=http://localhost:3000

# Session JWT signing secret — minimum 32 characters.
# SESSION_SECRET=replace-with-a-random-64-char-string-in-production

# ─── Issue #5: Gemini / Channel3 ─────────────────────────────────────────────

# Google Gemini API key from AI Studio.
# GEMINI_API_KEY=AIza...

# Gemini model ID. Defaults to gemini-1.5-pro.
# GEMINI_MODEL=gemini-1.5-pro

# Channel3 product catalog API key.
# CHANNEL3_API_KEY=ch3_...

# Product catalog adapter. Options: channel3 | fixture
# CATALOG_MODE=fixture

# ─── Issue #6: PayPal ─────────────────────────────────────────────────────────

# PayPal REST app credentials from the Developer Dashboard.
# PAYPAL_CLIENT_ID=AV...
# PAYPAL_CLIENT_SECRET=EL...

# Client ID exposed to the browser for the PayPal JS SDK.
# NEXT_PUBLIC_PAYPAL_CLIENT_ID=AV...

# Webhook ID from the PayPal Developer Dashboard (used for signature verification).
# PAYPAL_WEBHOOK_ID=...

# PayPal environment. Options: sandbox | live
# PAYPAL_ENV=sandbox

# ─── Issue #4/#6: Authority signing key (Ed25519) ────────────────────────────

# Base64-encoded DER private key. Generate with scripts/generate-keys.ts (issue #4).
# AUTHORITY_PRIVATE_KEY_B64=...
# AUTHORITY_PUBLIC_KEY_B64=...

# ─── Issue #16: Merchant signing key (Ed25519) ───────────────────────────────

# Separate key for the simulated merchant agent endpoint.
# MERCHANT_PRIVATE_KEY_B64=...
# MERCHANT_PUBLIC_KEY_B64=...
